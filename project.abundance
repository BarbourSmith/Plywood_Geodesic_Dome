          "interpreterVersion": 1,
          "code": "/**\n * Flat 2D outline of one dome rib, drawn in the rib's own plane.\n * The rib stands in the plane through the dome center and its edge, so it is\n * a flat part. Origin = dome center, +Y = toward the middle of the edge.\n * Near each end the outer and inner edges follow the hub cap planes (which are\n * perpendicular to the hub's radial axis) out to the cap radius, so the caps\n * sit flat on the rib. The ends stop at the hub core, parallel to the axis.\n */\nfunction run(\n  domeDiameter: number = 4000,\n  chordFactor: number = 0.348615,\n  ribDepth: number = 120,\n  hubDiameter: number = 300,\n  hubCoreDiameter: number = 80,\n): Assembly {\n  const R = domeDiameter / 2;\n  const half = Math.asin(chordFactor / 2); // half the central angle of the edge\n  const s = Math.sin(half), c = Math.cos(half);\n  const rCore = hubCoreDiameter / 2, rCap = hubDiameter / 2;\n  if (rCap <= rCore) throw new Error(\"Hub Diameter must be larger than Hub Core Diameter\");\n  if (2 * rCap * c >= chordFactor * R) throw new Error(\"Hubs are too big for this dome: caps would meet\");\n\n  // Hub axes (unit) at each end, and cap-plane directions pointing along the rib\n  const uP = [-s, c], uQ = [s, c];\n  const tP = [c, s], tQ = [-c, s];\n  const at = (u: number[], t: number[], radius: number, d: number): [number, number] => [\n    u[0] * radius + t[0] * d,\n    u[1] * radius + t[1] * d,\n  ];\n  const rIn = R - ribDepth;\n\n  const pts: [number, number][] = [\n    at(uP, tP, R, rCore),\n    at(uP, tP, R, rCap),\n    at(uQ, tQ, R, rCap),\n    at(uQ, tQ, R, rCore),\n    at(uQ, tQ, rIn, rCore),\n    at(uQ, tQ, rIn, rCap),\n    at(uP, tP, rIn, rCap),\n    at(uP, tP, rIn, rCore),\n  ];\n  let d = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) d = d.lineTo(pts[i]);\n  return new Assembly({ geometry: d.close() });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Flat 2D outline of one dome rib, drawn in the rib's own plane.\n * The rib stands in the plane through the dome center and its edge, so it is\n * a flat part. Origin = dome center, +Y = toward the middle of the edge.\n * Near each end the outer and inner edges follow the hub cap planes (which are\n * perpendicular to the hub's radial axis) out to the cap radius, so the caps\n * sit flat on the rib. The ends stop at the hub core, parallel to the axis.\n */\nfunction run(domeDiameter = 4000, chordFactor = 0.348615, ribDepth = 120, hubDiameter = 300, hubCoreDiameter = 80) {\n    const R = domeDiameter / 2;\n    const half = Math.asin(chordFactor / 2); // half the central angle of the edge\n    const s = Math.sin(half), c = Math.cos(half);\n    const rCore = hubCoreDiameter / 2, rCap = hubDiameter / 2;\n    if (rCap <= rCore)\n        throw new Error(\"Hub Diameter must be larger than Hub Core Diameter\");\n    if (2 * rCap * c >= chordFactor * R)\n        throw new Error(\"Hubs are too big for this dome: caps would meet\");\n    // Hub axes (unit) at each end, and cap-plane directions pointing along the rib\n    const uP = [-s, c], uQ = [s, c];\n    const tP = [c, s], tQ = [-c, s];\n    const at = (u, t, radius, d) => [\n        u[0] * radius + t[0] * d,\n        u[1] * radius + t[1] * d,\n    ];\n    const rIn = R - ribDepth;\n    const pts = [\n        at(uP, tP, R, rCore),\n        at(uP, tP, R, rCap),\n        at(uQ, tQ, R, rCap),\n        at(uQ, tQ, R, rCore),\n        at(uQ, tQ, rIn, rCore),\n        at(uQ, tQ, rIn, rCap),\n        at(uP, tP, rIn, rCap),\n        at(uP, tP, rIn, rCore),\n    ];\n    let d = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        d = d.lineTo(pts[i]);\n    return new Assembly({ geometry: d.close() });\n}\n"
